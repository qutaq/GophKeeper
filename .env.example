# PostgreSQL
DATABASE_URL=postgres://gophkeeper:gophkeeper@localhost:5432/gophkeeper?sslmode=disable

# gRPC
GOPHKEEPER_GRPC_ADDR=:50051
GOPHKEEPER_GRPC_REFLECTION=true
GOPHKEEPER_MIGRATIONS_DIR=migrations

# Optional server TLS (custom certificate + key). When both set, gRPC serves over TLS.
# GOPHKEEPER_TLS_CERT=/path/to/server.crt
# GOPHKEEPER_TLS_KEY=/path/to/server.key

# AES-256 at-rest key (64 hex chars = 32 bytes)
GOPHKEEPER_ATREST_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT HMAC keys: kid:hex[,kid:hex...] (each key >= 32 bytes). Current kid optional (defaults to last).
GOPHKEEPER_JWT_KEYS=v1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GOPHKEEPER_JWT_CURRENT_KID=v1
GOPHKEEPER_JWT_ISSUER=gophkeeper
GOPHKEEPER_ACCESS_TTL=15m
GOPHKEEPER_REFRESH_TTL=720h

# Client
# GOPHKEEPER_SERVER=localhost:50051
# GOPHKEEPER_DATA_DIR=
# GOPHKEEPER_TLS=true
# GOPHKEEPER_TLS_CA=/path/to/ca.crt
# GOPHKEEPER_TLS_CLIENT_CERT=/path/to/client.crt
# GOPHKEEPER_TLS_CLIENT_KEY=/path/to/client.key
# GOPHKEEPER_TLS_SKIP_VERIFY=false
