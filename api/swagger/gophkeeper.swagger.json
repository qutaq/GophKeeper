{
  "swagger": "2.0",
  "info": {
    "title": "GophKeeper API",
    "description": "gRPC API for private data vault with multi-device sync.",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "AuthService"
    },
    {
      "name": "DataService"
    },
    {
      "name": "SyncService"
    }
  ],
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/auth/login": {
      "post": {
        "summary": "Login authenticates a user and returns access/refresh tokens.",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Logout revokes the given refresh token.",
        "operationId": "AuthService_Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1LogoutResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1LogoutRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "summary": "Refresh exchanges a valid refresh token for a new token pair.",
        "operationId": "AuthService_Refresh",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RefreshResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RefreshRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "Register creates a new user account.",
        "operationId": "AuthService_Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1RegisterResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1RegisterRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/items": {
      "get": {
        "summary": "ListItems returns items belonging to the authenticated owner.",
        "operationId": "DataService_ListItems",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListItemsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "type",
            "description": "If set, only items of this type are returned.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "DATA_TYPE_UNSPECIFIED",
              "DATA_TYPE_CREDENTIALS",
              "DATA_TYPE_TEXT",
              "DATA_TYPE_BINARY",
              "DATA_TYPE_CARD",
              "DATA_TYPE_OTP"
            ],
            "default": "DATA_TYPE_UNSPECIFIED"
          },
          {
            "name": "include_deleted",
            "description": "When true, soft-deleted items are included.",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "tags": [
          "DataService"
        ]
      },
      "post": {
        "summary": "AddItem creates a new encrypted item for the authenticated owner.",
        "operationId": "DataService_AddItem",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1AddItemResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1AddItemRequest"
            }
          }
        ],
        "tags": [
          "DataService"
        ]
      }
    },
    "/v1/items/{id}": {
      "get": {
        "summary": "GetItem returns a single item by id if owned by the caller.",
        "operationId": "DataService_GetItem",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetItemResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DataService"
        ]
      },
      "delete": {
        "summary": "DeleteItem soft-deletes an item (deleted=true) for sync-friendly removal.",
        "operationId": "DataService_DeleteItem",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteItemResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "DataService"
        ]
      },
      "put": {
        "summary": "UpdateItem updates an existing item owned by the caller.",
        "operationId": "DataService_UpdateItem",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateItemResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DataServiceUpdateItemBody"
            }
          }
        ],
        "tags": [
          "DataService"
        ]
      }
    },
    "/v1/sync": {
      "post": {
        "summary": "Sync returns all item changes for the owner since the given cursor.\nSoft-deleted items are included so clients can converge.",
        "operationId": "SyncService_Sync",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1SyncResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1SyncRequest"
            }
          }
        ],
        "tags": [
          "SyncService"
        ]
      }
    }
  },
  "definitions": {
    "DataServiceUpdateItemBody": {
      "type": "object",
      "properties": {
        "encrypted_data": {
          "type": "string",
          "format": "byte"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "expected_version": {
          "type": "string",
          "format": "int64",
          "description": "expected_version enables optimistic concurrency control."
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1AddItemRequest": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/v1DataType"
        },
        "encrypted_data": {
          "type": "string",
          "format": "byte"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "v1AddItemResponse": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/definitions/v1Item"
        }
      }
    },
    "v1DataType": {
      "type": "string",
      "enum": [
        "DATA_TYPE_UNSPECIFIED",
        "DATA_TYPE_CREDENTIALS",
        "DATA_TYPE_TEXT",
        "DATA_TYPE_BINARY",
        "DATA_TYPE_CARD",
        "DATA_TYPE_OTP"
      ],
      "default": "DATA_TYPE_UNSPECIFIED",
      "description": "DataType enumerates supported private data kinds."
    },
    "v1DeleteItemResponse": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/definitions/v1Item"
        }
      }
    },
    "v1GetItemResponse": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/definitions/v1Item"
        }
      }
    },
    "v1Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "owner_id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/v1DataType"
        },
        "encrypted_data": {
          "type": "string",
          "format": "byte"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "format": "int64"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "description": "Item is a private data record. Payload is already E2E-encrypted by the client."
    },
    "v1ListItemsResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Item"
          }
        }
      }
    },
    "v1LoginRequest": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "v1LoginResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/v1User"
        }
      }
    },
    "v1LogoutRequest": {
      "type": "object",
      "properties": {
        "refresh_token": {
          "type": "string"
        }
      }
    },
    "v1LogoutResponse": {
      "type": "object"
    },
    "v1RefreshRequest": {
      "type": "object",
      "properties": {
        "refresh_token": {
          "type": "string"
        }
      }
    },
    "v1RefreshResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        }
      }
    },
    "v1RegisterRequest": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "v1RegisterResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/v1User"
        }
      }
    },
    "v1SyncRequest": {
      "type": "object",
      "properties": {
        "since_version": {
          "type": "string",
          "format": "int64",
          "description": "since_version is the exclusive lower bound of item versions to return."
        },
        "since_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "since_timestamp is an optional alternative cursor (items with updated_at \u003e value)."
        }
      }
    },
    "v1SyncResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Item"
          }
        },
        "server_version": {
          "type": "string",
          "format": "int64",
          "description": "server_version is the highest item version among returned (or known) items."
        }
      }
    },
    "v1UpdateItemResponse": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/definitions/v1Item"
        }
      }
    },
    "v1User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "User is a registered account (no secrets in the wire model)."
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "JWT access token. Format: Bearer \u003ctoken\u003e",
      "name": "Authorization",
      "in": "header"
    }
  }
}
